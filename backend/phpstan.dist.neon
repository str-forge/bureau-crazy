parameters:
    level: 6
    
    paths:
        - src
        - tests

    # Erlaubt dynamische Schutzschalter (z.B. is_object, method_exists) gegen unvorhersehbare 
    # API-Payloads, ohne dass PHPStan diese Prüfungen statisch als redundant bewertet.
    treatPhpDocTypesAsCertain: false

    # Verhindert, dass PHPStan fehlschlägt, wenn ein definiertes Ignore-Pattern in einem 
    # spezifischen Datei-Durchlauf mal nicht aktiv matched.
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Ignoriert Warnungen bei method_exists(). In den REST-Controllern werden diese Prüfungen 
        # als Schutzschalter für dynamische JSON-Payloads benötigt, während PHPStan sie in den 
        # isolierten Tests fälschlicherweise als unmöglich/redundant einstuft.
        - '#Call to function method_exists\(\)#'

        # Ignoriert Warnungen bei is_object(). Sichert die dynamische API-Validierung ab.
        - '#Call to function is_object\(\)#'

        # Ignoriert Seiteneffekt-Warnungen. PHPStan bewertet Entity-Zustandsänderungen (wie das 
        # Hochzählen von fehlgeschlagenen Login-Versuchen vor einer Sperrprüfung) standardmäßig 
        # als reine, unveränderliche Getter, was zu falschen "always false"-Meldungen führt.
        - '#If condition is always false\.#'

        # Ignoriert redundante Assertions in Testdateien. Fängt PHPUnit-Meldungen ab, die durch 
        # die scharfe Level-6-Signaturüberprüfung als statisch "immer wahr" bewertet werden.
        - '#will always evaluate to true\.#'
