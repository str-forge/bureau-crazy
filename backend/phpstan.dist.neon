parameters:
    level: 6
    paths:
        - src
        - tests
    treatPhpDocTypesAsCertain: true
    reportUnmatchedIgnoredErrors: true
    
    # NEU: Verhindert, dass PHPStan geänderte Entity-Zustände fälschlicherweise als "immer gleich" cached
    rememberPossiblyImpureFunctionValues: false

    ignoreErrors: []
