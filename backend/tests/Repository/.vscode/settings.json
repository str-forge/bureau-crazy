{
    // Tell Intelephense where the PHP infrastructure is located
    "intelephense.environment.includePaths": [
        "backend",
        "backend/vendor"
    ],
    // Optional: Improve monorepo search performance by excluding the Node frontend
    "intelephense.files.exclude": [
        "**/node_modules/**",
        "**/vendor/**/tests/**"
    ],
    // Help VS Code locate the autoloader directly
    "php.suggest.basic": false
}